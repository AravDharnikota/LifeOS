# ---- AravOS server configuration ----
# Required for AI features (food photo analysis, body progress, in-app agent, scheduler).
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default claude-sonnet-5-5). Opus is stronger for planning; Haiku is cheaper for food logging.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5

# A long random secret. The web app, iOS app, and every MCP client must present it as
# `Authorization: Bearer <token>`. Leave empty to disable auth (local development only).
ARAVOS_TOKEN=

# Where SQLite + uploaded photos live.
ARAVOS_DATA_DIR=./data
PORT=8787

# Public URL of this server (used for Google OAuth redirect and MCP instructions).
ARAVOS_PUBLIC_URL=http://localhost:8787

# Google Calendar + Tasks sync (optional). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials (Web application) and add
# `${ARAVOS_PUBLIC_URL}/api/google/callback` as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your timezone (IANA). Used by the scheduler and daily summaries.
ARAVOS_TIMEZONE=America/Los_Angeles
